# Copy to .env (git-ignored) and fill in. Restart Jenkins after editing .env.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
# Optional: folder on the Windows agent that each successful Windows build is copied into.
WINDOWS_DROP_DIR=
# GitHub user or org that owns the repo, and the repo name.
GITHUB_OWNER=your-github-user
GITHUB_REPO=electron-cpp-testbed
# Fine-grained token scoped to that repo with: Contents (read), Pull requests (read),
# Commit statuses (read & write), Metadata (read).
GITHUB_TOKEN=github_pat_xxx
